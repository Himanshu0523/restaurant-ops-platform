# Root Environment Example for Servio Monorepo
# Copy Backend/.env.example -> Backend/.env
# Copy frontend/apps/web/.env.example -> frontend/apps/web/.env.local

# Backend environment details:
# Backend/src/main.ts uses PORT (default 3000) and MONGODB_URL
# Frontend apps/web uses NEXT_PUBLIC_API_URL (default http://localhost:3000)
